rules_version = '2';
// Seuls les comptes Google ci-dessous peuvent lire ou modifier la liste.
// À coller dans Console Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "kaanordagda5@gmail.com"
        ];
    }
    match /lists/{listId}/items/{itemId} {
      allow read, write: if isFamily();
    }
  }
}
